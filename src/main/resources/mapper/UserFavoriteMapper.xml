<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bingran.mapper.UserFavoriteMapper">
    <resultMap id="BaseResultMap" type="com.bingran.entity.UserFavorite">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="favorite_cities" property="favoriteCities"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id, user_id, favorite_cities, create_time, update_time
        FROM user_favorite
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT id, user_id, favorite_cities, create_time, update_time
        FROM user_favorite
        WHERE user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_favorite (user_id, favorite_cities)
        VALUES (#{userId}, #{favoriteCities})
    </insert>

    <update id="update">
        UPDATE user_favorite SET
            favorite_cities = #{favoriteCities}
        WHERE id = #{id}
    </update>
</mapper>
